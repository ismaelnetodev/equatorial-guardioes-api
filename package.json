{
  "name": "equatorial-guardioes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace apps/api",
    "admin:user": "npm run admin:user --workspace apps/api",
    "dev:mobile": "npm run start --workspace apps/mobile",
    "dev:web": "npm run web --workspace apps/mobile",
    "start:api": "npm run start --workspace apps/api",
    "build:api": "npm run build --workspace apps/api",
    "build:mobile": "npm run build --workspace apps/mobile",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace apps/api",
    "db:generate": "npm run db:generate --workspace apps/api",
    "db:deploy": "npm run db:deploy --workspace apps/api",
    "db:migrate": "npm run db:migrate --workspace apps/api --",
    "db:studio": "npm run db:studio --workspace apps/api",
    "api:types": "node --import tsx scripts/generate-api-types.mjs",
    "check:mobile": "npm exec --workspace apps/mobile -- expo install --check"
  },
  "overrides": {
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "esbuild@0.28.2": true
  }
}
