NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# 0 para acesso direto; configure conforme os proxies confiáveis da hospedagem.
TRUST_PROXY_HOPS=0
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Somente em desenvolvimento: permite localhost e IPs privados, em qualquer porta.
CORS_ALLOW_LOCAL_NETWORK=true
# Produção: NODE_ENV=production e CORS_ORIGINS=https://app.seudominio.com

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Opcional: conexão direta para migrations; no Neon, use DATABASE_URL com pool
# na API e DIRECT_DATABASE_URL sem pool para a CLI. Preserve os parâmetros TLS.
DIRECT_DATABASE_URL=
AUTH_TOKEN_SECRET=configure-a-long-random-secret
