# Copie para .env.demo (ou exporte as variaveis) em apresentacoes / demos
# em que a fila de limites diarios de treino nao deve bloquear a narrativa.
# Nao coloque segredos reais neste arquivo.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
TRUST_PROXY_HOPS=0
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
CORS_ALLOW_LOCAL_NETWORK=true

DATABASE_URL=
DIRECT_DATABASE_URL=
AUTH_TOKEN_SECRET=configure-a-long-random-secret

# Demo: ignora training_modules_daily / training_points_daily (credito imediato).
POINTS_DAILY_LIMITS_ENABLED=false
# Opcional: intervalo do consumidor in-process em ms (0 desliga).
POINTS_QUEUE_INTERVAL_MS=0

AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_REPORTS_BUCKET=
