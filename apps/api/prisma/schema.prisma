// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DISABLED
}

enum QuizPhase {
  PRE
  POST
}

enum TrainingStepKind {
  RECOGNIZE
  DO_NOT
  INFO
}

enum ReportStatus {
  SENT
  RECEIVED
  IN_ANALYSIS
  RESOLVED
  NOT_CONFIRMED
}

enum ReportUrgency {
  LOW
  MEDIUM
  HIGH
}

enum PointLedgerReason {
  QUIZ_PRE
  QUIZ_TRAINING
  QUIZ_POST
  REPORT_SEND
  REPORT_CONFIRM
  INVITE_REWARD
  REDEMPTION
  BACKFILL
}

enum RewardRedemptionStatus {
  COMPLETED
}

model User {
  id               String           @id @default(uuid()) @db.Uuid
  role             UserRole         @default(USER)
  name             String
  email            String?          @unique
  cellphone        String?          @unique
  passwordHash     String
  neighborhood     String
  neighborhoodId   String?
  neighborhoodRecord Neighborhood? @relation(fields: [neighborhoodId], references: [id])
  inviteCode       String?          @unique
  termsAcceptedAt  DateTime
  moduleProgresses ModuleProgress[]
  reports          Report[]
  pointAccount     PointAccount?
  pointLedger      PointLedgerEntry[]
  redemptions      RewardRedemption[]
  invitesSent      InviteAttribution[] @relation("InvitesSent")
  invitedBy        InviteAttribution?  @relation("InvitedBy")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model PointAccount {
  userId       String   @id @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accumulated  Int      @default(0)
  balance      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PointLedgerEntry {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @db.Uuid
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta              Int
  affectsAccumulated Boolean
  reason             PointLedgerReason
  sourceType         String
  sourceId           String?
  createdAt          DateTime           @default(now())

  @@index([userId, createdAt])
  @@unique([reason, sourceType, sourceId])
}

model RewardRedemption {
  id          String                 @id @default(uuid()) @db.Uuid
  userId      String                 @db.Uuid
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardKey   String
  pointsSpent Int
  status      RewardRedemptionStatus @default(COMPLETED)
  createdAt   DateTime               @default(now())

  @@index([userId, createdAt])
  @@index([rewardKey, createdAt])
}

model InviteAttribution {
  id                  String    @id @default(uuid()) @db.Uuid
  inviterId           String    @db.Uuid
  inviter             User      @relation("InvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId           String    @unique @db.Uuid
  invitee             User      @relation("InvitedBy", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviteCode          String
  registeredAt        DateTime  @default(now())
  module0CompletedAt  DateTime?
  pointsAwarded       Int       @default(0)

  @@index([inviterId, registeredAt])
}

model Neighborhood {
  id               String @id
  name             String
  municipalityCode String
  municipalityName String
  state            String
  source           String
  users            User[]

  @@index([municipalityCode, name])
}

model Trail {
  publicationStatus ContentStatus @default(DRAFT)
  order       Int           @unique
  id          String        @id @default(uuid()) @db.Uuid
  title       String
  description String
  modules     TrailModule[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model TrailModule {
  publicationStatus ContentStatus @default(DRAFT)
  id              String   @id @default(uuid()) @db.Uuid
  trailId         String   @db.Uuid
  trail           Trail    @relation(fields: [trailId], references: [id], onDelete: Cascade)
  title           String
  description     String
  content         String   @db.Text
  order           Int
  durationMinutes Int?
  isActive        Boolean  @default(true)
  requiresQuiz    Boolean  @default(false)
  quizMinimumScore Int?
  progressRecords ModuleProgress[]
  quizQuestions   QuizQuestion[]
  trainingSteps   TrainingStep[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([trailId, order])
  @@index([trailId, order])
}

model ModuleProgress {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @db.Uuid
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId            String    @db.Uuid
  module              TrailModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  startedAt           DateTime  @default(now())
  completedAt         DateTime?
  preTestCompletedAt  DateTime?
  trainingCompletedAt DateTime?
  trainingPointsAwarded Int     @default(0)
  attempts            QuizAttempt[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
}

model QuizQuestion {
  id               String       @id @default(uuid()) @db.Uuid
  moduleId         String       @db.Uuid
  module           TrailModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  statement        String       @db.Text
  order            Int
  explanationTitle String       @db.Text
  explanationBody  String       @db.Text
  imageUrl         String?
  options          QuizOption[]
  answers          QuizAnswer[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([moduleId, order])
}

model QuizOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  answers    QuizAnswer[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model QuizAttempt {
  id            String       @id @default(uuid()) @db.Uuid
  progressId    String       @db.Uuid
  progress      ModuleProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  phase         QuizPhase
  correctCount  Int
  totalCount    Int
  score         Float
  isApproved    Boolean
  pointsAwarded Int          @default(0)
  minimumCorrect Int?
  supersededAt DateTime?
  finishedAt    DateTime?
  submittedAt   DateTime     @default(now())
  answers       QuizAnswer[]

  // Índice único parcial de POST aberto mantido em SQL na migration 20261017040000.
  @@index([progressId, phase, submittedAt])
}

model QuizAnswer {
  id         String       @id @default(uuid()) @db.Uuid
  attemptId  String       @db.Uuid
  attempt    QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String       @db.Uuid
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  optionId   String       @db.Uuid
  option     QuizOption   @relation(fields: [optionId], references: [id], onDelete: Restrict)
  isCorrect  Boolean
  answeredAt DateTime     @default(now())

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

model TrainingStep {
  id              String            @id @default(uuid()) @db.Uuid
  moduleId        String            @db.Uuid
  module          TrailModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  kind            TrainingStepKind  @default(INFO)
  order           Int
  durationMinutes Int?
  introText       String?           @db.Text
  cards           TrainingCard[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([moduleId, order])
  @@index([moduleId, order])
}

model TrainingCard {
  id          String       @id @default(uuid()) @db.Uuid
  stepId      String       @db.Uuid
  step        TrainingStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  title       String
  description String       @db.Text
  order       Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([stepId, order])
  @@index([stepId, order])
}

model Report {
  id            String                @id @default(uuid()) @db.Uuid
  userId        String                @db.Uuid
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String                @db.Text
  address       String
  neighborhood  String
  photoUrl      String?
  latitude      Float?
  longitude     Float?
  status        ReportStatus          @default(SENT)
  urgency       ReportUrgency         @default(MEDIUM)
  pointsAwarded Int                   @default(0)
  confirmedRisk ReportUrgency?
  validatedAt   DateTime?
  impactSeenAt  DateTime?
  submittedAt   DateTime              @default(now())
  timeline      ReportTimelineEvent[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([userId, submittedAt])
  @@index([status, submittedAt])
  @@index([userId, validatedAt])
}

model ReportTimelineEvent {
  id         String       @id @default(uuid()) @db.Uuid
  reportId   String       @db.Uuid
  report     Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  status     ReportStatus
  occurredAt DateTime     @default(now())

  @@index([reportId, occurredAt])
}

enum ProgramConfigurationKind {
  RULE
  REWARD
  LIMIT
}

// Valores operacionais do programa; não representa saldo ou lançamento de pontos.
model ProgramConfiguration {
  key         String @id
  kind        ProgramConfigurationKind
  name        String
  description String @db.Text
  value       Int?
  unit        String
  isActive    Boolean @default(true)
  updatedAt   DateTime @updatedAt

  @@index([kind, key])
}

// Snapshots sem FK ao usuário/configuração para preservar a auditoria após exclusões.
model ProgramConfigurationChange {
  id        String @id @default(uuid()) @db.Uuid
  key       String
  kind      ProgramConfigurationKind
  before    Json?
  after     Json
  actorId   String? @db.Uuid
  reason    String? @db.Text
  createdAt DateTime @default(now())

  @@index([kind, key, createdAt])
  @@index([createdAt, id])
}

// Snapshot de reconciliação dos pontos concedidos antes da validação v2.
model ReportLegacyPointsAudit {
  reportId String @id @db.Uuid
  userId String? @db.Uuid
  status ReportStatus?
  urgency ReportUrgency?
  pointsAwarded Int?
  reconciledAt DateTime? @db.Timestamptz(6)
}

// Snapshot por evento; sem FK para preservar a auditoria após exclusão de conteúdo.
model LearningAward {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  ruleKey String
  sourceId String
  moduleId String? @db.Uuid
  trailId String? @db.Uuid
  points Int
  grantedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([userId, ruleKey, sourceId])
  @@index([userId, ruleKey, grantedAt])
}

model FinalExamAttempt {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  trailId String @db.Uuid
  correctCount Int
  totalCount Int
  minimumCorrect Int
  isApproved Boolean
  pointsAwarded Int
  submittedAt DateTime @default(now())

  @@index([userId, trailId, submittedAt])
}

// Snapshots da conclusão, sem FK editorial para preservar o certificado emitido.
model TrailCertificate {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  trailId String @db.Uuid
  holderName String
  trailTitle String
  issuedAt DateTime @default(now())

  @@unique([userId, trailId])
}

model LearningLegacyPointsAudit {
  sourceId String @db.Uuid
  sourceType String
  points Int
  reconciledAt DateTime @default(now())

  @@id([sourceType, sourceId])
}

// Snapshot sem FK para preservar a auditoria da reconciliação de duplicatas.
model QuizAttemptReconciliation {
  attemptId String @id @db.Uuid
  retainedAttemptId String @db.Uuid
  previousState Json
  reconciledAt DateTime @default(now())
}
